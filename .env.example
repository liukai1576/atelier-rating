# 数据读写由本机 lark-cli 完成；App Secret 由 CLI 的凭证库管理，不写入本项目
# 如果只配置了一个 CLI profile，可以留空
LARK_CLI_PROFILE=
LARK_CLI_IDENTITY=user
# 通常无需填写；找不到命令时可改成 lark-cli 的绝对路径
LARK_CLI_BIN=lark-cli

# 多维表格的 base token
FEISHU_BITABLE_APP_TOKEN=basxxxxxxxxxxxxxxxx

# 六张业务表 URL 中 table= 后的 table_id
FEISHU_WORKSHOPS_TABLE_ID=tblxxxxxxxxxxxxxxxx
FEISHU_RUBRICS_TABLE_ID=tblxxxxxxxxxxxxxxxx
FEISHU_PROJECTS_TABLE_ID=tblxxxxxxxxxxxxxxxx
FEISHU_SCORES_TABLE_ID=tblxxxxxxxxxxxxxxxx
FEISHU_TEAMS_TABLE_ID=tblxxxxxxxxxxxxxxxx
FEISHU_JUDGES_TABLE_ID=tblxxxxxxxxxxxxxxxx

# 推荐：用飞书表格持久化多个评分项目的配置
FEISHU_REGISTRY_BASE_TOKEN=basxxxxxxxxxxxxxxxx
FEISHU_REGISTRY_TABLE_ID=tblxxxxxxxxxxxxxxxx
FEISHU_TEMPLATE_BASE_URL=https://example.feishu.cn/base/basxxxxxxxxxxxxxxxx
# 必填：保护独立的 /admin 配置后台；部署时请使用高强度随机值
ATELIER_CONFIG_ADMIN_KEY=change-me

# 公开评分台地址；Admin 会使用它生成并写入飞书的评委专属链接
ATELIER_PUBLIC_SITE_URL=https://your-score-desk.example.com
# 至少 32 个随机字符，用来签名评委专属链接会话
ATELIER_SESSION_SECRET=replace-with-a-long-random-secret
