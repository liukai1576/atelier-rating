# 数据读写由本机 lark-cli 完成；App Secret 由 CLI 的凭证库管理，不写入本项目
# 如果只配置了一个 CLI profile，可以留空
LARK_CLI_PROFILE=
LARK_CLI_IDENTITY=user
# 通常无需填写；找不到命令时可改成 lark-cli 的绝对路径
LARK_CLI_BIN=lark-cli

# 多维表格的 base token
FEISHU_BITABLE_APP_TOKEN=basxxxxxxxxxxxxxxxx

# 项目、评分两张数据表 URL 中 table= 后的 table_id
FEISHU_PROJECTS_TABLE_ID=tblxxxxxxxxxxxxxxxx
FEISHU_SCORES_TABLE_ID=tblxxxxxxxxxxxxxxxx

# 可选。配置后项目通过“项目组ID”读取独立的项目组名称、负责人、成员、简介与资料链接
FEISHU_TEAMS_TABLE_ID=tblxxxxxxxxxxxxxxxx

# 可选。不配置时继续使用评分台内置评委名单
FEISHU_JUDGES_TABLE_ID=tblxxxxxxxxxxxxxxxx
